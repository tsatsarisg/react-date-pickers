# Enforce strict dependency resolution
strict-peer-dependencies=true

# Security: prevent lifecycle scripts from untrusted packages
ignore-scripts=true

# Security: prevent package substitution / dependency confusion attacks
auto-install-peers=true

# Lock the registry to the official npm registry
registry=https://registry.npmjs.org/

# Hoist only when needed — limits supply-chain attack surface
shamefully-hoist=false
hoist=true

# Produce reproducible installs
frozen-lockfile=false

# Use exact versions by default when adding new deps
save-exact=true
